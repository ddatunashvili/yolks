#!/bin/bash
# Build the Nim project in the current directory and run what it produced.
#
#   Dependencies: `nimble install -y --depsOnly` against the .nimble file.
#   Entry: NIM_MAIN when set, else the first `bin` the .nimble file names
#   (under its srcDir). Compiled with -d:release into .renode-app/.
#
# Environment:
#   NIM_MAIN     entry .nim file, relative to this folder; blank = .nimble bin
#   NIM_FLAGS    extra compiler flags, such as -d:ssl or --mm:orc
#   SERVER_PORT  exported as PORT
#
# Everything this script says goes to stderr: some entrypoints capture the
# startup command's stdout and execute it.
set -u
shopt -s nullglob

say() { printf '\033[1m\033[36m[nim-start]\033[0m %s\n' "$*" >&2; }

nimbles=( *.nimble )
if [ "${#nimbles[@]}" -eq 0 ]; then
    say "No .nimble file in $(pwd). Upload your project with SFTP or the file manager, or link a repository on the GitHub tab."
    exit 1
fi
if [ "${#nimbles[@]}" -gt 1 ]; then
    say "Several .nimble files here (${nimbles[*]}); keep one."
    exit 1
fi
nimble_file="${nimbles[0]}"

export PORT="${PORT:-${SERVER_PORT:-8080}}"
export ADDRESS="${ADDRESS:-0.0.0.0}"

# First quoted value of a `key = "..."` or `key = @["..."]` line.
nimble_value() {
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*@\{0,1\}\[\{0,1\}[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$nimble_file" | head -n 1
}

if [ -n "${NIM_MAIN:-}" ]; then
    main="$NIM_MAIN"
    bin=$(basename "$main" .nim)
else
    bin=$(nimble_value bin)
    if [ -z "$bin" ]; then
        say "$nimble_file names no bin = @[\"...\"], so there is nothing to run. Add one, or set NIM_MAIN on the Startup tab to your entry .nim file."
        exit 1
    fi
    src=$(nimble_value srcDir)
    main="${src:+$src/}$bin.nim"
    bin=$(basename "$bin")
fi

if [ ! -f "$main" ]; then
    say "The entry file $main does not exist."
    exit 1
fi

say "Installing dependencies from $nimble_file"
nimble install -y --depsOnly >&2 || { say "nimble install failed."; exit 1; }

mkdir -p .renode-app
say "Compiling $main (release)"
# shellcheck disable=SC2086
nim c -d:release --hints:off ${NIM_FLAGS:-} --out:".renode-app/$bin" "$main" >&2 \
    || { say "nim c failed."; exit 1; }

say "Starting $bin on $ADDRESS:$PORT"
exec "./.renode-app/$bin"
