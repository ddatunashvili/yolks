#!/bin/bash
# Starts n8n on the server's own port with its data in ./.n8n.
# Everything said here goes to stderr.
set -euo pipefail

say() { echo "[n8n-start] $*" >&2; }

ROOT=$(pwd)
export N8N_USER_FOLDER="${N8N_USER_FOLDER:-${ROOT}}"

# The egg passes the per-server key as N8N_ENCRYPTION_SECRET (a name the panel
# recognises as a secret and generates). n8n reads N8N_ENCRYPTION_KEY.
if [[ -z "${N8N_ENCRYPTION_KEY:-}" && -n "${N8N_ENCRYPTION_SECRET:-}" ]]; then
    export N8N_ENCRYPTION_KEY="${N8N_ENCRYPTION_SECRET}"
fi
unset N8N_ENCRYPTION_SECRET
if [[ -z "${N8N_ENCRYPTION_KEY:-}" ]]; then
    say "No encryption key: set N8N_ENCRYPTION_SECRET on the Startup tab. n8n encrypts every stored credential with it."
    exit 1
fi

# A key that differs from the one this data was created with makes every
# stored credential unreadable, and n8n refuses to start. Say so plainly.
CONFIG="${N8N_USER_FOLDER}/.n8n/config"
if [[ -f "${CONFIG}" ]] && ! grep -q "\"${N8N_ENCRYPTION_KEY}\"" "${CONFIG}"; then
    say "The encryption key does not match the one in .n8n/config, which this data was created with."
    say "Put the original key back on the Startup tab; changing it makes saved credentials unreadable."
fi

export PORT="${SERVER_PORT:-5678}"
export N8N_PORT="${PORT}"
export N8N_LISTEN_ADDRESS="${N8N_LISTEN_ADDRESS:-0.0.0.0}"
export DB_TYPE="${DB_TYPE:-sqlite}"
export N8N_DIAGNOSTICS_ENABLED="${N8N_DIAGNOSTICS_ENABLED:-false}"
export N8N_RUNNERS_ENABLED="${N8N_RUNNERS_ENABLED:-true}"
export GENERIC_TIMEZONE="${GENERIC_TIMEZONE:-${N8N_TIMEZONE:-${TZ:-UTC}}}"
export TZ="${TZ:-${GENERIC_TIMEZONE}}"

# A public domain (the panel's proxy in front of this server) is what webhook
# URLs are built from, and HTTPS is what lets the session cookie be secure.
# Without one, n8n is reached over plain http on the allocation, where a secure
# cookie would make the editor refuse to sign anybody in.
if [[ -n "${N8N_PUBLIC_DOMAIN:-}" ]]; then
    export WEBHOOK_URL="${WEBHOOK_URL:-https://${N8N_PUBLIC_DOMAIN}/}"
    export N8N_EDITOR_BASE_URL="${N8N_EDITOR_BASE_URL:-https://${N8N_PUBLIC_DOMAIN}/}"
    export N8N_SECURE_COOKIE="${N8N_SECURE_COOKIE:-true}"
    say "Public address: https://${N8N_PUBLIC_DOMAIN}/"
else
    [[ -z "${WEBHOOK_URL:-}" ]] && unset WEBHOOK_URL
    export N8N_SECURE_COOKIE="${N8N_SECURE_COOKIE:-false}"
    say "No public domain set: webhooks use this server's address. Add a domain with the proxy, then put it in Public Domain on the Startup tab."
fi

mkdir -p "${N8N_USER_FOLDER}/.n8n"
say "n8n on ${N8N_LISTEN_ADDRESS}:${PORT}, data in ${N8N_USER_FOLDER}/.n8n"
exec n8n start
