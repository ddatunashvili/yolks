#!/bin/bash
# Build and run the Gleam project in the current directory.
#
#   erlang target (default): `gleam export erlang-shipment`, then the
#   shipment's own entrypoint, which execs the BEAM directly.
#   javascript target: `gleam build --target javascript`, then Node (LTS,
#   shipped in this image) runs the package's main function.
#
# Environment:
#   GLEAM_TARGET   erlang (default) or javascript
#   SERVER_PORT    exported as PORT
#
# Everything this script says goes to stderr: some entrypoints capture the
# startup command's stdout and execute it.
set -u

say() { printf '\033[1m\033[36m[gleam-start]\033[0m %s\n' "$*" >&2; }

if [ ! -f gleam.toml ]; then
    say "No gleam.toml in $(pwd). Upload your project with SFTP or the file manager, or link a repository on the GitHub tab."
    exit 1
fi

name=$(sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\([A-Za-z0-9_]*\)".*/\1/p' gleam.toml | head -n 1)
if [ -z "$name" ]; then
    say "gleam.toml has no name = \"...\" line."
    exit 1
fi

target="${GLEAM_TARGET:-erlang}"
export PORT="${PORT:-${SERVER_PORT:-8000}}"

case "$target" in
    erlang|javascript) ;;
    *) say "GLEAM_TARGET must be erlang or javascript, not '$target'."; exit 1 ;;
esac

say "Fetching dependencies"
gleam deps download >&2 || { say "gleam deps download failed."; exit 1; }

if [ "$target" = erlang ]; then
    say "Building $name (erlang)"
    gleam export erlang-shipment >&2 || { say "gleam export erlang-shipment failed."; exit 1; }
    say "Starting $name on port $PORT"
    exec ./build/erlang-shipment/entrypoint.sh run
fi

say "Building $name (javascript)"
gleam build --target javascript >&2 || { say "gleam build failed."; exit 1; }
entry="./build/dev/javascript/$name/$name.mjs"
[ -f "$entry" ] || { say "The build produced no $entry."; exit 1; }
say "Starting $name on Node $(node --version) on port $PORT"
exec node --input-type=module -e "import { main } from '$entry'; main();"
